<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_salary_revision_wizard_form" model="ir.ui.view">
        <field name="name">hr.salary.revision.wizard.form</field>
        <field name="model">hr.salary.revision.wizard</field>
        <field name="arch" type="xml">
            <form string="Revise Monthly Salary">
                <group>
                    <group>
                        <field name="payslip_id" invisible="1"/>
                        <field name="employee_id"/>
                        <field name="contract_id"/>
                        <field name="effective_date"/>
                    </group>
                    <group>
                        <field name="current_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="revised_wage" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="difference" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                        <field name="percentage_change" widget="percentage"/>
                        <field name="currency_id" invisible="1"/>
                    </group>
                </group>
                <group><field name="reason"/></group>
                <footer>
                    <button name="action_apply_revision" type="object" string="Apply &amp; Recompute" class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
