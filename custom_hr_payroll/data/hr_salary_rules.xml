<odoo>
	<data noupdate="0">
		<record id="hr_rule_late" model="hr.salary.rule">
			<field name="name">Late Fine</field>
			<field name="sequence" eval="40" />
			<field name="code">LATE</field>
			<field name="category_id" ref="hr_payroll_community.DED" />
			<field name="condition_select">none</field>
			<field name="condition_python">result = contract.schedule_pay != 'hourly'</field>
			<field name="amount_select">code</field>
			<field name="amount_python_compute">result = -payslip.total_late_hours_amount</field>
		</record>

		<record id="hr_rule_overtime" model="hr.salary.rule">
			<field name="name">Overtime</field>
			<field name="sequence" eval="30" />
			<field name="code">OT</field>
			<field name="category_id" ref="hr_payroll_community.ALW" />
			<field name="condition_select">none</field>
			<field name="amount_select">code</field>
			<field name="amount_python_compute">result = (contract.overtime_rate * 60) * payslip.overtime_hours_month or 0</field>
		</record>

		<record id="hr_rule_special_days" model="hr.salary.rule">
			<field name="name">Special Working Days</field>
			<field name="sequence" eval="35" />
			<field name="code">SWD</field>
			<field name="category_id" ref="hr_payroll_community.ALW" />
			<field name="condition_select">none</field>
			<field name="amount_select">code</field>
			<field name="amount_python_compute">result = payslip.total_special_hours_amount</field>
		</record>

		<!-- Hourly Worker Salary Rule -->
		<record id="hr_rule_hourly" model="hr.salary.rule">
			<field name="name">Hourly Pay</field>
			<field name="sequence" eval="100" />
			<field name="code">HOURLY</field>
			<field name="category_id" ref="hr_payroll_community.BASIC" />

			<!-- Applies ONLY to contract.schedule_pay == 'hourly' -->
			<field name="condition_select">python</field>
			<field name="condition_python">
				# Apply only for hourly workers
				result = (contract.schedule_pay == 'hourly')
			</field>

			<!-- Amount is supplied by payslip line -->
			<field name="amount_select">code</field>
			<field name="amount_python_compute">
				# The Python model code already sets `amount` and `total`
				# Here we return amount as passed in inputs. Ensures no crash.
				result = amount or 0.0
			</field>

			<!-- Quantity also provided by payslip -->
			<field name="quantity">1.0</field>

			<!-- Appears on Payslip -->
			<field name="appears_on_payslip" eval="True" />
		</record>

	</data>
</odoo>