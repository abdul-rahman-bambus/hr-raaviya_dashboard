# Python bytecode and interpreter caches
__pycache__/
*.py[cod]
*$py.class

# Test and coverage artifacts
.coverage
.pytest_cache/
htmlcov/

# Local runtime files
*.log

# Locally captured/generated documentation binaries
bambus_hr_daily_ops/docs/screenshots/*
!bambus_hr_daily_ops/docs/screenshots/README.md
bambus_hr_daily_ops/docs/output/*
!bambus_hr_daily_ops/docs/output/README.md
