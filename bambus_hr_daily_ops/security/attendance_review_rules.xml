<?xml version='1.0' encoding='UTF-8'?>
<odoo>
    <!-- Multi-company: only show audit records belonging to user's allowed companies -->
    <record id="rule_bambus_hr_attendance_time_audit_multi_company" model="ir.rule">
        <field name="name">Bambus Attendance Time Audit: multi-company visibility</field>
        <field name="model_id" ref="bambus_hr_daily_ops.model_bambus_hr_attendance_time_audit"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>

    <record id="rule_bambus_hr_payslip_attendance_detail_multi_company" model="ir.rule">
        <field name="name">Payslip Attendance Details: multi-company visibility</field>
        <field name="model_id" ref="bambus_hr_daily_ops.model_bambus_hr_payslip_attendance_detail"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>
    </record>
    <record id="rule_attendance_day_review_company" model="ir.rule">
        <field name="name">Attendance decisions: selected companies</field>
        <field name="model_id" ref="model_bambus_attendance_day_review"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
