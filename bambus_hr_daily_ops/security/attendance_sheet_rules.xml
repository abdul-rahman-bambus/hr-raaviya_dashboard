<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Multi-company: only show sheets belonging to user's allowed companies -->
    <record id="rule_bambus_hr_attendance_sheet_multi_company" model="ir.rule">
        <field name="name">Bambus Attendance Sheet: multi-company visibility</field>
        <field name="model_id" ref="bambus_hr_daily_ops.model_bambus_hr_attendance_sheet"/>
        <field name="domain_force">[('company_id', 'in', user.company_ids.ids)]</field>

        <!-- Apply to internal users (adjust groups if needed) -->
        <field name="groups" eval="[(4, ref('base.group_user'))]"/>

        <!-- Allow read/write/create/unlink within allowed companies -->
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="1"/>
    </record>
</odoo>
