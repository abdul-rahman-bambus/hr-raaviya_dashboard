<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Keep database-backed asset declarations in addition to the manifest.
        Some upgraded databases retained the new client actions and menus while
        continuing to serve a backend bundle created before these files were
        added. These records are loaded during module upgrade and explicitly
        invalidate/rebuild that bundle. Duplicate paths are de-duplicated by
        Odoo's asset resolver.
    -->
    <record id="asset_attendance_timeline_css" model="ir.asset">
        <field name="name">Bambus Attendance Timeline styles</field>
        <field name="bundle">web.assets_backend</field>
        <field name="directive">append</field>
        <field name="path">bambus_hr_daily_ops/static/src/css/bambus_attendance_timeline.css</field>
        <field name="sequence">99</field>
    </record>
    <record id="asset_attendance_dashboard_css" model="ir.asset">
        <field name="name">Bambus Attendance Dashboard styles</field>
