<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_hr_salary_revision_wizard_automation" model="ir.ui.view">
        <field name="name">hr.salary.revision.wizard.automation</field>
        <field name="model">hr.salary.revision.wizard</field>
        <field name="inherit_id" ref="custom_hr_payroll.view_hr_salary_revision_wizard_form"/>
        <field name="arch" type="xml">
            <field name="current_calendar_id" position="after">
                <field name="current_automation_template_id"/>
            </field>
            <field name="revised_calendar_id" position="after">
                <field name="company_id" invisible="1"/>
                <field name="revised_automation_template_id"/>
            </field>
        </field>
    </record>

    <record id="view_hr_contract_salary_revision_automation" model="ir.ui.view">
        <field name="name">hr.contract.salary.revision.automation</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="custom_hr_payroll.view_hr_contract_form_salary_revision"/>
        <field name="arch" type="xml">
            <field name="revised_calendar_id" position="after">
                <field name="previous_automation_template_id" optional="hide"/>
                <field name="revised_automation_template_id" optional="show"/>
            </field>
        </field>
    </record>

    <record id="view_attendance_automation_assign_wizard" model="ir.ui.view">
        <field name="name">bambus.attendance.automation.assign.wizard.form</field>
        <field name="model">bambus.attendance.automation.assign.wizard</field>
        <field name="arch" type="xml">
            <form string="Assign Existing Employees">
                <group>
                    <field name="template_id"/>
                    <field name="company_id"/>
                    <field name="employee_ids" widget="many2many_tags"
                           options="{'no_create': True, 'no_create_edit': True}"
                           domain="[('company_id', '=', company_id), ('active', '=', True)]"/>
                </group>
                <footer>
                    <button name="action_assign" type="object" string="Assign Employees"
                            class="btn-primary"/>
                    <button special="cancel" string="Cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_attendance_automation_assign_wizard" model="ir.actions.act_window">
        <field name="name">Assign Existing Employees</field>
        <field name="res_model">bambus.attendance.automation.assign.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <record id="view_attendance_automation_template_list" model="ir.ui.view">
        <field name="name">bambus.attendance.automation.template.list</field>
        <field name="model">bambus.attendance.automation.template</field>
        <field name="arch" type="xml">
            <list string="Automation Rules">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="date_from"/>
                <field name="date_to"/>
                <field name="minimum_overtime_minutes"/>
                <field name="late_grace_minutes"/>
                <field name="employee_count" string="Assigned Staff"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_attendance_automation_template_form" model="ir.ui.view">
        <field name="name">bambus.attendance.automation.template.form</field>
        <field name="model">bambus.attendance.automation.template</field>
        <field name="arch" type="xml">
            <form string="Automation Rules Template">
                <sheet>
                    <div class="oe_title"><label for="name"/><h1><field name="name"/></h1></div>
                    <group>
                        <group>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="active"/>
                        </group>
                        <group string="Effective Period">
                            <field name="date_from"/>
                            <field name="date_to"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Late &amp; Early Exit">
                            <group string="Day Pay">
                                <field name="partial_attendance_salary_treatment"/>
                                <div class="text-muted" invisible="partial_attendance_salary_treatment != 'fine_only'">
                                    Monthly/Daily: an attended working date receives normal day pay.
                                    Missing scheduled time, including a missing session, is proposed
                                    under the enabled fine rules. Only approved fines are deducted.
                                    Whole-day absence gives no attendance pay. No leave is created.
                                </div>
                                <field name="reviewed_exception_day_pay" invisible="partial_attendance_salary_treatment != 'thresholds'"/>
                                <div class="text-muted" invisible="partial_attendance_salary_treatment != 'thresholds'">
                                    Monthly/Daily only. Regularize reviewed exception time for day pay;
                                    approved fines remain separate. Actual punches are retained.
                                    Review each session explicitly; missing halves require a leave decision.
                                </div>
                            </group>
                            <group string="Salary Rate Conversion">
                                <field name="salary_hours_basis"/>
                                <field name="salary_calculation_hours" invisible="salary_hours_basis != 'fixed'" required="salary_hours_basis == 'fixed'"/>
                                <div class="text-muted">
                                    Converts Monthly/Daily salary to per-hour and per-minute rates for fines and salary-based OT.
                                    Working Schedule uses the date's work sessions, excluding breaks; on dates without sessions,
                                    it uses the calendar's hours per day (8 hours if unavailable).
                                    Actual hours, day classification, fixed rates and saved approvals are unchanged.
                                </div>
                            </group>
                            <group string="Attendance Day Classification">
                                <field name="half_day_hours"/>
                                <field name="full_day_basis"/>
                                <field name="full_day_hours" invisible="full_day_basis != 'fixed'"/>
                            </group>
                            <group>
                                <group string="Late Entry">
                                    <field name="late_enabled"/>
                                    <field name="late_grace_minutes" invisible="not late_enabled"/>
                                    <field name="post_break_grace_minutes" invisible="not late_enabled"/>
                                </group>
                                <group string="Early Exit">
                                    <field name="early_exit_enabled"/>
                                    <field name="early_exit_grace_minutes" invisible="not early_exit_enabled"/>
                                </group>
                            </group>
                            <group string="Late / Fine Default" invisible="not late_enabled">
                                <field name="fine_calculation_type"/>
                                <field name="fine_rate" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       invisible="fine_calculation_type not in ('fixed', 'fixed_hour')"/>
                                <div class="text-muted" invisible="fine_calculation_type != 'salary_minute'">
                                    The deduction uses the employee's daily salary divided by
                                    salary calculation hours × 60, using the Salary Rate Conversion setting.
                                </div>
                            </group>
                        </page>
                        <page string="Breaks">
                            <group>
                                <field name="break_enabled"/>
                                <field name="allowed_break_minutes" invisible="not break_enabled"/>
                            </group>
                        </page>
                        <page string="Weekly Off">
                            <div class="alert alert-info" role="alert">
                                Enable Paid Weekly Offs to give Monthly employees normal
                                day credit even without attendance. Work on that day is an
                                additional earning under the weekly-off policy, subject to HR review.
                            </div>
                            <group>
                                <group string="Weekly Off Work">
                                    <field name="weekly_off_source"/>
                                    <field name="weekly_off_overtime_policy"/>
                                    <div class="text-muted">
                                        This policy controls additional pay for hours worked on a weekly off.
                                        All Worked Hours proposes overtime for HR review when the
                                        Overtime Rule is enabled. Not Payable means no additional overtime;
                                        it does not disable normal paid-day credit from Paid Weekly Offs.
                                        Calculation methods and rates come from the Overtime tab.
                                    </div>
                                </group>
                                <group string="Payroll Treatment">
                                    <field name="monthly_paid_weekly_off"/>
                                    <div class="text-muted">
                                        Regular worked hours are classified in the Weekly-off
                                        payroll bucket. Approved overtime hours and amounts are
                                        stored separately for payroll and reporting.
                                    </div>
                                </group>
                            </group>
                            <group string="Weekly Off Days" invisible="weekly_off_source != 'weekdays'">
                                <field name="weekly_off_monday"/>
                                <field name="weekly_off_tuesday"/>
                                <field name="weekly_off_wednesday"/>
                                <field name="weekly_off_thursday"/>
                                <field name="weekly_off_friday"/>
                                <field name="weekly_off_saturday"/>
                                <field name="weekly_off_sunday"/>
                            </group>
                        </page>
                        <page string="Overtime">
                            <group>
                                <group>
                                    <field name="overtime_enabled"/>
                                    <field name="minimum_overtime_minutes" invisible="not overtime_enabled"/>
                                    <field name="overtime_start_mode" invisible="not overtime_enabled"/>
                                    <field name="overtime_start_offset_minutes"
                                           invisible="not overtime_enabled or overtime_start_mode != 'offset'"/>
                                    <field name="overtime_start_hour" widget="float_time"
                                           invisible="not overtime_enabled or overtime_start_mode != 'fixed'"/>
                                    <field name="overtime_end_mode" invisible="not overtime_enabled"/>
                                    <field name="overtime_end_hour" widget="float_time"
                                           invisible="not overtime_enabled or overtime_end_mode != 'fixed'"/>
                                    <field name="maximum_overtime_minutes"
                                           invisible="not overtime_enabled or overtime_end_mode != 'duration'"/>
                                    <field name="overtime_rounding_minutes" invisible="not overtime_enabled"/>
                                </group>
                                <group string="Calculation Default" invisible="not overtime_enabled">
                                    <field name="overtime_calculation_type"
                                           invisible="overtime_rate_policy == 'salary_slab'"/>
                                    <field name="overtime_rate_policy"/>
                                    <div class="text-muted" invisible="overtime_rate_policy != 'salary_slab'">
                                        Salary slabs are applied as a fixed amount per OT hour.
                                    </div>
                                    <field name="overtime_salary_basis"
                                           invisible="overtime_rate_policy != 'salary_slab'"/>
                                    <field name="overtime_rate" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="overtime_rate_policy != 'fixed'"/>
                                </group>
                            </group>
                            <group string="OT Salary Slabs"
                                   invisible="not overtime_enabled or overtime_rate_policy != 'salary_slab'">
                                <field name="overtime_slab_ids" nolabel="1">
                                    <list editable="bottom">
                                        <field name="salary_from" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                        <field name="has_maximum"/>
                                        <field name="salary_to" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"
                                               invisible="not has_maximum"/>
                                        <field name="rate" widget="monetary"
                                               options="{'currency_field': 'currency_id'}"/>
                                        <field name="currency_id" column_invisible="True"/>
                                    </list>
                                </field>
                            </group>
                        </page>
                        <page string="Public Holiday Policy">
                            <div class="alert alert-info" role="alert">
                                Enable Paid Public Holidays to give Monthly employees normal
                                day credit even without attendance. Work on that day is an
                                additional earning under the holiday policy, subject to HR review.
                            </div>
                            <group>
                                <group string="Holiday Work">
                                    <field name="overtime_enabled"/>
                                    <field name="public_holiday_overtime_policy"
                                           invisible="not overtime_enabled"/>
                                    <field name="public_holiday_calculation_type"
                                           invisible="not overtime_enabled or public_holiday_rate_policy == 'salary_slab'"/>
                                    <field name="public_holiday_rate_policy"
                                           invisible="not overtime_enabled"/>
                                    <field name="public_holiday_rate" widget="monetary"
                                           options="{'currency_field': 'currency_id'}"
                                           invisible="not overtime_enabled or public_holiday_rate_policy != 'fixed'"/>
                                </group>
                                <group string="Payroll Treatment">
                                    <field name="monthly_paid_public_holiday"/>
                                    <div class="text-muted">
                                        Regular worked hours are classified in the Public Holidays
                                        payroll bucket. Approved overtime hours and amounts are
                                        stored separately for payroll and reporting.
                                    </div>
                                </group>
                            </group>
                        </page>
                        <page string="Hourly Pay">
                            <div class="alert alert-info" role="alert">
                                Hourly contracts do not use overtime, late/fine, or public-holiday
                                calculations. Enable this option to let HR review payable worked
                                hours using the contract hourly rate or another calculation type.
                            </div>
                            <group>
                                <field name="hourly_pay_enabled"/>
                                <field name="hourly_pay_use_template_limit"/>
                                <field name="hourly_wage_hour_limit"
                                       invisible="not hourly_pay_use_template_limit"/>
                                <field name="hourly_pay_calculation_type"
                                       invisible="not hourly_pay_enabled"/>
                                <field name="hourly_pay_rate" widget="monetary"
                                       options="{'currency_field': 'currency_id'}"
                                       invisible="not hourly_pay_enabled or hourly_pay_calculation_type not in ('fixed', 'fixed_hour')"/>
                            </group>
                        </page>
                        <page string="Assigned Employees">
                            <button name="%(action_attendance_automation_assign_wizard)d"
                                    type="action" string="Assign Existing Employees"
                                    class="btn-primary"
                                    context="{'default_template_id': id}"/>
                            <field name="employee_ids" readonly="1">
                                <list create="0" delete="0">
                                    <field name="name"/>
                                    <field name="department_id"/>
                                    <field name="job_id"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                    <field name="currency_id" invisible="1"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_attendance_automation_templates" model="ir.actions.act_window">
        <field name="name">Automation Rules</field>
        <field name="res_model">bambus.attendance.automation.template</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_attendance_automation_templates"
              name="Automation Rules"
              parent="menu_bambus_hrms_configuration"
              action="action_attendance_automation_templates"
              sequence="5" groups="hr.group_hr_manager"/>

    <record id="view_employee_form_automation_template" model="ir.ui.view">
        <field name="name">hr.employee.form.attendance.automation</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Attendance Rules" name="attendance_automation"
                      groups="hr.group_hr_user">
                    <group string="Attendance Automation">
                        <field name="attendance_automation_template_id"
                               options="{'no_create': True}"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
