<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A compact, operational employee directory inspired by a staff list.
         It deliberately lives in its own app menu so HR users do not have to
         navigate through the configuration-heavy Employees application. -->
    <record id="view_bambus_employee_list" model="ir.ui.view">
        <field name="name">bambus.hr.employee.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Employee List" multi_edit="1" sample="1">
                <field name="active" column_invisible="True"/>
                <field name="avatar_128" string="" widget="image"
                       options="{'size': [32, 32]}" width="44"/>
                <field name="name"/>
                <field name="barcode" string="Employee ID" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="work_phone" optional="hide"/>
                <field name="mobile_phone" optional="show"/>
                <field name="work_email" widget="email" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bambus_employee_search" model="ir.ui.view">
        <field name="name">bambus.hr.employee.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Search Employees">
                <field name="name" string="Employee"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('barcode', 'ilike', self), ('work_email', 'ilike', self)]"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="active_employees" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived_employees" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_job" string="Job Position"
                            context="{'group_by': 'job_id'}"/>
                    <filter name="group_by_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bambus_employee_list" model="ir.actions.act_window">
        <field name="name">Employee List</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bambus_employee_list"/>
        <field name="search_view_id" ref="view_bambus_employee_search"/>
        <field name="context">{'search_default_active_employees': 1, 'search_default_group_by_department': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first employee</p>
            <p>Keep employee contact, job, and department information in one place.</p>
        </field>
    </record>

    <menuitem id="menu_bambus_employees_root"
              name="Employees"
              action="action_bambus_employee_list"
              sequence="-90"
              groups="hr.group_hr_user"/>

    <record id="view_employee_form_inherit_view" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>

    <record id="hr_holidays_attendance.hr_employee_view_form_inherit" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    
</odoo>
