<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- A compact, operational employee directory inside the HRMS workspace. -->
    <record id="view_bambus_employee_list" model="ir.ui.view">
        <field name="name">bambus.hr.employee.list</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <list string="Employee List" multi_edit="1" sample="1">
                <field name="active" column_invisible="True"/>
                <field name="avatar_128" string="" widget="image"
                       options="{'size': [32, 32]}" width="44"/>
                <field name="name"/>
                <field name="barcode" string="Employee ID" optional="show"/>
                <field name="job_id" optional="show"/>
                <field name="department_id" optional="show"/>
                <field name="work_phone" optional="hide"/>
                <field name="mobile_phone" optional="show"/>
                <field name="work_email" widget="email" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"
                       optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_bambus_employee_search" model="ir.ui.view">
        <field name="name">bambus.hr.employee.search</field>
        <field name="model">hr.employee</field>
        <field name="arch" type="xml">
            <search string="Search Employees">
                <field name="name" string="Employee"
                       filter_domain="['|', '|', ('name', 'ilike', self), ('barcode', 'ilike', self), ('work_email', 'ilike', self)]"/>
                <field name="department_id"/>
                <field name="job_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <separator/>
                <filter name="active_employees" string="Active" domain="[('active', '=', True)]"/>
                <filter name="archived_employees" string="Archived" domain="[('active', '=', False)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter name="group_by_department" string="Department"
                            context="{'group_by': 'department_id'}"/>
                    <filter name="group_by_job" string="Job Position"
                            context="{'group_by': 'job_id'}"/>
                    <filter name="group_by_company" string="Company"
                            context="{'group_by': 'company_id'}"
                            groups="base.group_multi_company"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_bambus_employee_list" model="ir.actions.act_window">
        <field name="name">Employee List</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_bambus_employee_list"/>
        <field name="search_view_id" ref="view_bambus_employee_search"/>
        <field name="context">{'search_default_active_employees': 1, 'search_default_group_by_department': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first employee</p>
            <p>Keep employee contact, job, and department information in one place.</p>
        </field>
    </record>

    <record id="action_bambus_employee_dashboard" model="ir.actions.client">
        <field name="name">Employees</field>
        <field name="tag">bambus_employee_dashboard</field>
    </record>

    <menuitem id="menu_bambus_employees_root"
              name="Employees"
              parent="menu_bambus_hrms_root"
              action="action_bambus_employee_dashboard"
              sequence="10"
              groups="hr.group_hr_user"/>

    <record id="view_employee_form_inherit_view" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit.view</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_open_monthly_attendance" type="object"
                        class="oe_stat_button" icon="fa-calendar-check-o">
                    <div class="o_stat_info">
                        <span class="o_stat_text">Attendance</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//header/button[1]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Salary Overview" name="salary_overview"
                      groups="hr_payroll_community.group_hr_payroll_community_user">
                    <div class="o_bambus_salary_overview">
                        <div class="o_bso_heading">
                            <div>
                                <h3>Salary Overview</h3>
                                <p>Review this employee's generated payslips and payment history.</p>
                            </div>
                            <button name="action_open_salary_overview" type="object"
                                    string="View All Payslips" class="btn btn-primary"
                                    icon="fa-external-link"/>
                        </div>
                        <div class="o_bso_metrics">
                            <div class="o_bso_metric">
                                <span class="o_bso_metric_icon"><i class="fa fa-file-text-o"/></span>
                                <div><small>Total Payslips</small><strong><field name="payslip_count"/></strong></div>
                            </div>
                            <div class="o_bso_metric">
                                <span class="o_bso_metric_icon"><i class="fa fa-money"/></span>
                                <div><small>Latest Net Pay</small><strong><field name="latest_payslip_amount" widget="monetary" options="{'currency_field': 'payslip_currency_id'}"/></strong></div>
                            </div>
                            <div class="o_bso_metric">
                                <span class="o_bso_metric_icon"><i class="fa fa-line-chart"/></span>
                                <div><small>Year-to-date Pay</small><strong><field name="year_to_date_pay" widget="monetary" options="{'currency_field': 'payslip_currency_id'}"/></strong></div>
                            </div>
                        </div>
                        <field name="payslip_currency_id" invisible="1"/>
                        <div class="o_bso_list">
                            <field name="slip_ids" readonly="1" nolabel="1">
                                <list string="Payslips" create="0" delete="0"
                                      decoration-success="state == 'done'"
                                      decoration-muted="state == 'cancel'">
                                    <field name="name" string="Pay Period"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="basic_pay" sum="Total Basic"/>
                                    <field name="gross_pay" sum="Total Gross"/>
                                    <field name="net_pay" sum="Total Net"/>
                                    <field name="state" widget="badge"
                                           decoration-success="state == 'done'"
                                           decoration-warning="state in ('draft', 'verify')"
                                           decoration-danger="state == 'cancel'"/>
                                </list>
                            </field>
                        </div>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <!-- Make the existing payroll entry point explicit and easy to discover.
         This keeps the standard smart-button workflow while the tab above
         provides the same records inline. -->
    <record id="view_employee_form_salary_overview_button" model="ir.ui.view">
        <field name="name">hr.employee.form.salary.overview.button</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll_community.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[field[@name='payslip_count']]" position="replace">
                <button name="action_open_salary_overview" type="object"
                        class="oe_stat_button" icon="fa-money"
                        groups="hr_payroll_community.group_hr_payroll_community_user">
                    <field name="payslip_count" widget="statinfo"
                           string="Salary Overview"/>
                </button>
            </xpath>
        </field>
    </record>

    <record id="hr_holidays_attendance.hr_employee_view_form_inherit" model="ir.ui.view">
        <field name="active" eval="False"/>
    </record>
    
</odoo>
