<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="bambus_hr_daily_ops.AttendanceEditor">
    <div class="o_bambus_attendance_dashboard">
      <div class="o_bad_toolbar">
        <div><h2>Attendance</h2><span t-if="state.data">Update daily employee attendance · <t t-esc="state.data.company"/></span></div>
        <div class="o_bad_actions" t-if="state.data">
          <button class="btn btn-light" t-on-click="() => this.moveDate(-1)" title="Previous day"><i class="fa fa-chevron-left"/></button>
          <input class="form-control" type="date" t-att-value="state.data.date" t-on-change="(ev) => this.changeDate(ev)"/>
          <button class="btn btn-light" t-on-click="() => this.moveDate(1)" title="Next day"><i class="fa fa-chevron-right"/></button>
          <button class="btn btn-outline-secondary" t-on-click="openHistory">History</button>
        </div>
      </div>
      <div t-if="state.loading" class="o_bad_loading"><i class="fa fa-spinner fa-spin"/> Loading employees…</div>
      <div t-elif="state.error" class="alert alert-danger"><strong>Attendance could not be loaded.</strong> <span t-esc="state.error"/></div>
      <t t-elif="state.data">
        <div class="o_bad_metrics o_bad_editor_metrics">
          <t t-foreach="[['total','All Staff','fa-users'],['present','Present','fa-check-circle'],['absent','Absent','fa-times-circle'],['halfday','Half Day','fa-adjust'],['leave','On Leave','fa-plane'],['punched_in','Punched In','fa-sign-in'],['punched_out','Punched Out','fa-sign-out'],['overtime','Overtime Hours','fa-clock-o','hours'],['fine','Late / Fine Hours','fa-money','hours'] ]" t-as="metric" t-key="metric[0]">
            <div t-att-class="'o_bad_metric ' + (['overtime', 'fine'].includes(metric[0]) ? 'o_bad_metric_action' : '')" t-on-click="() => this.openMetric(metric[0])"><i t-att-class="'fa ' + metric[2]"/><div><span t-esc="metric[1]"/><strong t-esc="metricValue(metric)"/></div></div>
          </t>
        </div>
        <section class="o_bae_entry">
          <div class="o_bae_filters"><div class="o_bad_dashboard_search"><i class="fa fa-search"/><input type="search" placeholder="Search Staff by Name, Department or Schedule" t-att-value="state.query" t-on-input="updateQuery"/></div><label class="o_bad_filter_control"><i class="fa fa-filter"/><select t-att-value="state.statusFilter" t-on-change="updateStatusFilter"><option value="all">Filter</option><option value="present">Present</option><option value="absent">Absent</option><option value="not_marked">Not Marked</option><option value="halfday">Half Day</option><option value="leave">Leave</option><option value="overtime">Overtime</option><option value="fine">Late / Fine</option></select></label></div>
          <div class="o_bae_group" t-foreach="dailyGroups" t-as="group" t-key="group.id">
            <button type="button" class="o_bae_group_title" t-on-click="() => this.toggleContractType(group.id)"><i t-att-class="'fa ' + (isContractTypeCollapsed(group.id) ? 'fa-chevron-right' : 'fa-chevron-down')"/><span t-esc="group.name"/><span><t t-esc="group.employees.length"/></span></button>
            <t t-if="!isContractTypeCollapsed(group.id)"><article t-foreach="group.employees" t-as="employee" t-key="employee.id" t-att-class="'o_bae_employee ' + (isSaving(employee.id) ? 'o_bad_row_saving' : '')">
              <div class="o_bae_employee_info"><div><strong t-esc="employee.name"/><small t-if="employee.employee_code">#<t t-esc="employee.employee_code"/></small></div><span t-if="employee.has_attendance"><t t-esc="formatHours(employee.worked_hours)"/> Hrs</span><span t-elif="employee.leave_id" class="text-warning" t-esc="employee.leave_is_half_day ? 'Half Day Leave' : 'Full Day Leave'"/><span t-elif="employee.status === 'absent'" class="text-danger">Absent</span><span t-elif="employee.status === 'present'" class="text-success">Present</span><span t-else="" class="text-danger">Not Marked</span><span t-esc="employee.shift"/><div class="o_bae_links"><button type="button" class="btn btn-link" t-on-click="() => this.openLogs(employee)"><i class="fa fa-list"/> Logs <t t-if="employee.logs.length">(<t t-esc="employee.logs.length"/>)</t></button></div></div>
              <div class="o_bae_actions">
                <div t-att-class="'o_bae_action present ' + (employee.status === 'present' ? 'active' : '')"><button type="button" t-on-click="() => this.setStatus(employee, 'present')"><b>P</b><span>Present</span></button><div t-if="!employee.is_hourly"><input type="time" title="Punch In" t-att-value="employee.check_in_value" t-on-change="(ev) => this.updateEmployeeField(employee, 'check_in_value', ev)"/><i class="fa fa-long-arrow-right"/><input type="time" title="Punch Out" t-att-value="employee.check_out_value" t-on-change="(ev) => this.updateEmployeeField(employee, 'check_out_value', ev)"/></div><div t-else=""><button type="button" t-on-click="() => this.openTimingAdjustment(employee)"><b>PI</b> <t t-esc="employee.check_in || 'Punch In'"/></button><i class="fa fa-long-arrow-right"/><button type="button" t-on-click="() => this.openTimingAdjustment(employee)"><b>PO</b> <t t-esc="employee.check_out || 'Punch Out'"/></button></div></div>
                <button t-if="!employee.is_hourly" type="button" t-att-class="'o_bae_action halfday ' + (employee.status === 'halfday' || (employee.leave_id &amp;&amp; employee.leave_is_half_day) ? 'active' : '')" t-on-click="() => this.createHalfDayLeave(employee)"><b>HD</b><span t-esc="employee.status === 'halfday' || (employee.leave_id &amp;&amp; employee.leave_is_half_day) ? 'Remove Half Day' : 'Half Day Leave'"/></button>
                <button type="button" t-att-class="'o_bae_action absent ' + (employee.status === 'absent' ? 'active' : '')" t-on-click="() => this.toggleAbsent(employee)"><b>A</b><span t-esc="employee.status === 'absent' ? 'Remove Absent' : 'Absent'"/></button>
                <button type="button" class="o_bae_action fine" t-att-disabled="!employee.fine_enabled" t-on-click="() => this.openAdjustment(employee, 'fine')" title="Review late / fine"><b>F</b><span>Late / Fine</span><strong t-esc="formatHours(employee.fine_hours)"/></button>
                <button type="button" class="o_bae_action overtime" t-att-disabled="!employee.overtime_enabled" t-on-click="() => this.openAdjustment(employee, 'overtime')" title="Review overtime"><b>OT</b><span>Overtime</span><strong t-esc="formatHours(employee.overtime_hours)"/></button>
                <button t-if="employee.is_hourly &amp;&amp; employee.hourly_pay_enabled" type="button" class="o_bae_action overtime" t-on-click="() => this.openAdjustment(employee, 'hourly_pay')" title="Review hourly pay"><b>HP</b><span>Hourly Pay</span><strong t-esc="formatHours(employee.hourly_pay_hours)"/></button>
                <button t-if="!employee.is_hourly" type="button" t-att-class="'o_bae_action leave ' + (employee.status === 'leave' || (employee.leave_id &amp;&amp; !employee.leave_is_half_day) ? 'active' : '')" t-on-click="() => this.toggleLeave(employee)"><b>L</b><span t-esc="employee.status === 'leave' || (employee.leave_id &amp;&amp; !employee.leave_is_half_day) ? 'Remove Leave' : 'Leave'"/></button>
              </div>
            </article></t>
          </div><div class="o_bae_empty" t-if="!dailyEmployees.length">No employees match the selected filters</div>
          <div class="o_bad_pagination"><div class="o_bad_page_summary">Showing <strong t-esc="firstVisibleEmployee"/>–<strong t-esc="lastVisibleEmployee"/> of <strong t-esc="filteredDailyEmployees.length"/> employees</div><div class="o_bad_page_size"><label for="o_bae_page_size">Rows per page</label><select id="o_bae_page_size" class="form-select form-select-sm" t-att-value="state.pageSize" t-on-change="updatePageSize"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select></div><div class="btn-group"><button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.currentPage === 1" t-on-click="() => this.goToPage(state.currentPage - 1)"><i class="fa fa-chevron-left"/></button><span class="btn btn-light btn-sm disabled">Page <t t-esc="state.currentPage"/> of <t t-esc="pageCount"/></span><button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.currentPage === pageCount" t-on-click="() => this.goToPage(state.currentPage + 1)"><i class="fa fa-chevron-right"/></button></div></div>
        </section>
        <div class="o_baa_modal_backdrop" t-if="state.timingAdjustment" t-on-click.self="closeTimingAdjustment">
          <section class="o_baa_modal" role="dialog" aria-modal="true" aria-labelledby="o_bat_title">
            <header class="o_baa_header"><div><span class="o_baa_icon"><i class="fa fa-clock-o"/></span><div><h3 id="o_bat_title">Update Punch Times</h3><p><strong t-esc="state.timingAdjustment.employee.name"/> · <t t-esc="state.data.date"/></p></div></div><button type="button" t-on-click="closeTimingAdjustment" aria-label="Close"><i class="fa fa-times"/></button></header>
            <div class="o_baa_body"><div class="o_baa_grid"><label><span>Punch In</span><input type="time" t-att-value="state.timingAdjustment.checkIn" t-on-change="(ev) => this.updateTimingField('checkIn', ev)"/></label><label><span>Punch Out</span><input type="time" t-att-value="state.timingAdjustment.checkOut" t-on-change="(ev) => this.updateTimingField('checkOut', ev)"/></label></div></div>
            <footer class="o_baa_footer"><button type="button" class="btn btn-light" t-on-click="closeTimingAdjustment">Cancel</button><button type="button" class="btn btn-primary" t-on-click="saveTimingAdjustment">Save</button></footer>
          </section>
        </div>
        <div class="o_bea_modal_backdrop" t-if="state.logEmployee" t-on-click.self="closeLogs">
          <section class="o_bea_log_modal" role="dialog" aria-modal="true" aria-labelledby="o_bae_log_title"><button type="button" class="o_bea_modal_close" t-on-click="closeLogs" aria-label="Close"><i class="fa fa-times"/></button><h3 id="o_bae_log_title" t-esc="state.logEmployee.name"/><p>Attendance logs · <t t-esc="state.data.date"/></p><div class="o_bea_log_scroll">
            <article class="o_bea_log" t-foreach="state.logEmployee.logs" t-as="log" t-key="log.id"><img t-if="log.image_url" t-att-src="log.image_url" t-att-alt="log.label"/><div t-else="" class="o_bea_log_placeholder"><i t-att-class="'fa ' + (log.type === 'hr_update' ? 'fa-pencil' : 'fa-user')"/></div><div class="o_bea_log_copy"><strong><i t-att-class="'fa ' + (log.type === 'check_in' ? 'fa-sign-in' : (log.type === 'check_out' ? 'fa-sign-out' : 'fa-pencil'))"/> <t t-esc="log.label"/> via <t t-esc="log.mode"/></strong><span t-if="log.details" t-esc="log.details"/><span t-if="log.address" t-esc="log.address"/><small>By <t t-esc="log.actor"/> at <t t-esc="log.time"/></small></div></article>
            <div class="o_bea_no_logs" t-if="!state.logEmployee.logs.length"><i class="fa fa-camera"/><span>No punch logs were captured for this employee on the selected date.</span></div>
          </div><button type="button" class="btn btn-outline-primary o_bea_done" t-on-click="closeLogs">Done</button></section>
        </div>
        <div class="o_baa_modal_backdrop" t-if="state.adjustment" t-on-click.self="closeAdjustment">
          <section class="o_baa_modal" role="dialog" aria-modal="true" aria-labelledby="o_baa_title">
            <header class="o_baa_header"><div><span class="o_baa_icon"><i t-att-class="'fa ' + (state.adjustment.adjustment === 'overtime' ? 'fa-clock-o' : 'fa-money')"/></span><div><h3 id="o_baa_title" t-esc="state.adjustment.adjustment === 'overtime' ? 'Update Overtime' : (state.adjustment.adjustment === 'hourly_pay' ? 'Update Hourly Pay' : 'Update Late / Fine')"/><p><strong t-esc="state.adjustment.employee"/> · <t t-esc="state.adjustment.date"/></p></div></div><button type="button" t-on-click="closeAdjustment" aria-label="Close"><i class="fa fa-times"/></button></header>
            <div class="o_baa_body">
              <div class="o_baa_detected"><span>System calculated</span><strong t-esc="adjustmentHours(state.adjustment.detected_hours)"/><small>Review the detected time, make any HR correction, then save.</small></div>
              <div class="o_baa_grid">
                <label><span t-esc="state.adjustment.adjustment === 'overtime' ? 'Final overtime hours' : (state.adjustment.adjustment === 'hourly_pay' ? 'Final payable hours' : 'Final fine hours')"/><div class="o_baa_hours"><input type="text" inputmode="numeric" pattern="[0-9]+:[0-5][0-9]" t-att-value="adjustmentHours(state.adjustment.hours)" t-on-change="updateAdjustmentHours"/><em>hrs</em></div></label>
                <label><span>Calculation type</span><select t-att-value="state.adjustment.calculation_type" t-on-change="(ev) => this.updateAdjustmentField('calculation_type', ev)"><option t-foreach="state.adjustment.calculation_options" t-as="option" t-key="option[0]" t-att-value="option[0]" t-esc="option[1]"/></select></label>
                <label t-if="['fixed', 'fixed_hour'].includes(state.adjustment.calculation_type)"><span t-esc="state.adjustment.calculation_type === 'fixed' ? 'Amount' : 'Rate per hour'"/><div class="o_baa_money"><span t-esc="state.adjustment.currency.symbol"/><input type="number" min="0" step="0.01" t-att-value="state.adjustment.rate" t-on-input="(ev) => this.updateAdjustmentField('rate', ev)"/></div></label>
              </div>
              <label class="o_baa_note"><span t-esc="state.adjustment.adjustment === 'fine' ? 'Reason' : 'Note'"/><textarea rows="2" placeholder="Optional HR note" t-att-value="state.adjustment.note" t-on-input="(ev) => this.updateAdjustmentField('note', ev)"/></label>
              <div class="o_baa_total"><span t-esc="state.adjustment.adjustment === 'overtime' ? 'Total overtime amount' : (state.adjustment.adjustment === 'hourly_pay' ? 'Total hourly pay' : 'Total deduction')"/><strong t-esc="formatAdjustmentAmount(adjustmentAmount)"/></div>
            </div>
            <footer class="o_baa_footer"><button type="button" class="btn btn-light" t-on-click="closeAdjustment" t-att-disabled="state.adjustment.saving">Cancel</button><button type="button" class="btn btn-primary" t-on-click="saveAdjustment" t-att-disabled="state.adjustment.saving"><i t-att-class="'fa ' + (state.adjustment.saving ? 'fa-spinner fa-spin' : 'fa-check')"/><t t-esc="state.adjustment.saving ? ' Saving…' : (state.adjustment.adjustment === 'overtime' ? ' Apply Overtime' : (state.adjustment.adjustment === 'hourly_pay' ? ' Apply Hourly Pay' : ' Apply Fine'))"/></button></footer>
          </section>
        </div>
      </t>
    </div>
  </t>
</templates>
