<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="bambus_hr_daily_ops.AttendanceEditor">
    <div class="o_bambus_attendance_dashboard">
      <div class="o_bad_toolbar">
        <div><h2>Attendance</h2><span t-if="state.data">Update daily employee attendance · <t t-esc="state.data.company"/></span></div>
        <div class="o_bad_actions" t-if="state.data">
          <button class="btn btn-light" t-on-click="() => this.moveDate(-1)" title="Previous day"><i class="fa fa-chevron-left"/></button>
          <input class="form-control" type="date" t-att-value="state.data.date" t-on-change="(ev) => this.changeDate(ev)"/>
          <button class="btn btn-light" t-on-click="() => this.moveDate(1)" title="Next day"><i class="fa fa-chevron-right"/></button>
          <button class="btn btn-outline-secondary" t-on-click="openHistory">History</button>
        </div>
      </div>
      <div t-if="state.loading" class="o_bad_loading"><i class="fa fa-spinner fa-spin"/> Loading employees…</div>
      <div t-elif="state.error" class="alert alert-danger"><strong>Attendance could not be loaded.</strong> <span t-esc="state.error"/></div>
      <t t-elif="state.data">
        <div class="o_bad_metrics o_bad_editor_metrics">
          <t t-foreach="[['total','All Staff','fa-users'],['present','Present','fa-check-circle'],['absent','Absent','fa-times-circle'],['halfday','Half Day','fa-adjust'],['leave','On Leave','fa-plane'],['punched_in','Punched In','fa-sign-in'],['punched_out','Punched Out','fa-sign-out'],['overtime','Overtime Hours','fa-clock-o','hours'],['fine','Fine Hours','fa-money','hours'] ]" t-as="metric" t-key="metric[0]">
            <div class="o_bad_metric"><i t-att-class="'fa ' + metric[2]"/><div><span t-esc="metric[1]"/><strong t-esc="metricValue(metric)"/></div></div>
          </t>
        </div>
        <section class="o_bae_entry">
          <div class="o_bae_filters"><div class="o_bad_dashboard_search"><i class="fa fa-search"/><input type="search" placeholder="Search Staff by Name, Department or Schedule" t-att-value="state.query" t-on-input="updateQuery"/></div><label class="o_bad_filter_control"><i class="fa fa-filter"/><select t-att-value="state.statusFilter" t-on-change="updateStatusFilter"><option value="all">Filter</option><option value="present">Present</option><option value="absent">Absent</option><option value="not_marked">Not Marked</option><option value="halfday">Half Day</option><option value="leave">Leave</option></select></label></div>
          <div class="o_bae_group" t-foreach="dailyGroups" t-as="group" t-key="group.id">
            <button type="button" class="o_bae_group_title" t-on-click="() => this.toggleContractType(group.id)"><i t-att-class="'fa ' + (isContractTypeCollapsed(group.id) ? 'fa-chevron-right' : 'fa-chevron-down')"/><span t-esc="group.name"/><span><t t-esc="group.employees.length"/></span></button>
            <t t-if="!isContractTypeCollapsed(group.id)"><article t-foreach="group.employees" t-as="employee" t-key="employee.id" t-att-class="'o_bae_employee ' + (isSaving(employee.id) ? 'o_bad_row_saving' : '')">
              <div class="o_bae_employee_info"><div><strong t-esc="employee.name"/><small t-if="employee.employee_code">#<t t-esc="employee.employee_code"/></small></div><span><t t-esc="formatHours(employee.worked_hours)"/> Hrs</span><span t-esc="employee.shift"/><button type="button" class="btn btn-link" t-on-click="() => this.saveEmployee(employee)"><i class="fa fa-save"/> Save Changes</button></div>
              <div class="o_bae_actions">
                <div t-att-class="'o_bae_action present ' + (employee.status === 'present' ? 'active' : '')"><button type="button" t-on-click="() => this.setStatus(employee, 'present')"><b>P</b><span>Present</span></button><div><input type="time" title="Punch In" t-att-value="employee.check_in_value" t-on-input="(ev) => this.updateEmployeeField(employee, 'check_in_value', ev)"/><i class="fa fa-long-arrow-right"/><input type="time" title="Punch Out" t-att-value="employee.check_out_value" t-on-input="(ev) => this.updateEmployeeField(employee, 'check_out_value', ev)"/></div></div>
                <button type="button" t-att-class="'o_bae_action halfday ' + (employee.status === 'halfday' ? 'active' : '')" t-on-click="() => this.setStatus(employee, 'halfday')"><b>HD</b><span>Half Day</span></button>
                <button type="button" t-att-class="'o_bae_action absent ' + (['absent','not_marked'].includes(employee.status) ? 'active' : '')" t-on-click="() => this.setStatus(employee, 'absent')"><b>A</b><span>Absent</span></button>
                <label class="o_bae_action fine"><b>F</b><span>Fine</span><input type="number" min="0" step="0.25" t-att-value="employee.fine_hours" t-on-input="(ev) => this.updateEmployeeField(employee, 'fine_hours', ev)"/></label>
                <label class="o_bae_action overtime"><b>OT</b><span>Overtime</span><input type="number" min="0" step="0.25" t-att-value="employee.overtime_hours" t-on-input="(ev) => this.updateEmployeeField(employee, 'overtime_hours', ev)"/></label>
                <button type="button" t-att-class="'o_bae_action leave ' + (employee.status === 'leave' ? 'active' : '')" t-on-click="() => this.setStatus(employee, 'leave')"><b>L</b><span>Leave</span></button>
              </div>
            </article></t>
          </div><div class="o_bae_empty" t-if="!dailyEmployees.length">No employees match the selected filters</div>
          <div class="o_bad_pagination"><div class="o_bad_page_summary">Showing <strong t-esc="firstVisibleEmployee"/>–<strong t-esc="lastVisibleEmployee"/> of <strong t-esc="filteredDailyEmployees.length"/> employees</div><div class="o_bad_page_size"><label for="o_bae_page_size">Rows per page</label><select id="o_bae_page_size" class="form-select form-select-sm" t-att-value="state.pageSize" t-on-change="updatePageSize"><option value="10">10</option><option value="25">25</option><option value="50">50</option></select></div><div class="btn-group"><button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.currentPage === 1" t-on-click="() => this.goToPage(state.currentPage - 1)"><i class="fa fa-chevron-left"/></button><span class="btn btn-light btn-sm disabled">Page <t t-esc="state.currentPage"/> of <t t-esc="pageCount"/></span><button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.currentPage === pageCount" t-on-click="() => this.goToPage(state.currentPage + 1)"><i class="fa fa-chevron-right"/></button></div></div>
        </section>
      </t>
    </div>
  </t>
</templates>
