<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="bambus_hr_daily_ops.EmployeeAttendance">
    <main class="o_bea_dashboard">
      <button type="button" class="o_bea_back" t-on-click="goBack"><i class="fa fa-arrow-left"/> Back</button>
      <div t-if="state.loading" class="o_bea_state"><i class="fa fa-spinner fa-spin"/> Loading attendance…</div>
      <div t-elif="state.error" class="alert alert-danger o_bea_state">
        <strong>Attendance could not be loaded.</strong> <span t-esc="state.error"/>
      </div>
      <t t-elif="state.data">
        <header class="o_bea_header">
          <h2><t t-esc="state.data.employee.name"/> <small t-if="state.data.employee.barcode">#<t t-esc="state.data.employee.barcode"/></small></h2>
          <button type="button" class="btn btn-outline-primary" t-on-click="downloadReport"><i class="fa fa-download"/> Download Report</button>
        </header>
        <section class="o_bea_summary">
          <div class="o_bea_month">
            <button type="button" t-on-click="() => this.moveMonth(-1)" aria-label="Previous month"><i class="fa fa-chevron-left"/></button>
            <label><span t-esc="state.data.month_label"/><input type="month" t-att-value="state.data.month" t-on-change="changeMonth" aria-label="Select month"/></label>
            <button type="button" t-on-click="() => this.moveMonth(1)" aria-label="Next month"><i class="fa fa-chevron-right"/></button>
          </div>
          <div class="o_bea_approval"><i class="fa fa-check-circle"/> Attendance Summary</div>
          <div class="o_bea_metrics">
            <div><span>Days</span><strong t-esc="state.data.metrics.days"/></div>
            <div><span>Present</span><strong t-esc="state.data.metrics.present"/></div>
            <div><span>Absent</span><strong t-esc="state.data.metrics.absent"/></div>
            <div><span>Half Day</span><strong t-esc="state.data.metrics.halfday"/></div>
            <div><span>Leave</span><strong t-esc="state.data.metrics.leave"/></div>
            <div><span>Punched In</span><strong t-esc="state.data.metrics.punched_in"/></div>
            <div><span>Punched Out</span><strong t-esc="state.data.metrics.punched_out"/></div>
          </div>
        </section>
        <div class="o_bea_tabs">
          <button type="button" t-att-class="state.activeView === 'daily' ? 'active' : ''" t-on-click="() => state.activeView = 'daily'">Daily Attendance View</button>
          <button type="button" t-att-class="state.activeView === 'calendar' ? 'active' : ''" t-on-click="() => state.activeView = 'calendar'">Calendar View</button>
        </div>
        <section class="o_bea_days" t-if="state.activeView === 'daily'">
          <article class="o_bea_day" t-foreach="state.data.rows" t-as="row" t-key="row.date">
            <div class="o_bea_day_info"><strong t-esc="formatDate(row.date)"/><span><t t-esc="formatHours(row.worked_hours)"/> Hrs</span><button type="button" t-on-click="() => this.openLogs(row)">Logs</button></div>
            <span t-att-class="'o_bea_status ' + row.status"><b t-esc="row.status_label"/><t t-if="row.check_in"> | <t t-esc="row.check_in"/> - <t t-esc="row.check_out || 'Punched In'"/></t></span>
            <span class="o_bea_detail"><b>OT</b> | <t t-esc="formatHours(row.overtime_hours)"/> Hrs</span>
            <span class="o_bea_detail fine"><b>F</b> | <t t-esc="formatHours(row.fine_hours)"/> Hrs</span>
          </article>
          <div class="o_bea_empty" t-if="!state.data.rows.length"><i class="fa fa-calendar-o"/><strong>No attendance for this month</strong></div>
        </section>
        <section class="o_bea_calendar" t-else="">
          <div class="o_bea_weekdays">
            <span>Sunday</span><span>Monday</span><span>Tuesday</span><span>Wednesday</span><span>Thursday</span><span>Friday</span><span>Saturday</span>
          </div>
          <div class="o_bea_calendar_week" t-foreach="calendarWeeks" t-as="week" t-key="week[0].key">
            <button type="button" t-foreach="week" t-as="day" t-key="day.key"
                    t-att-class="'o_bea_calendar_day ' + (!day.inMonth ? 'outside' : '') + (day.row &amp;&amp; day.row.logs.length ? ' has-logs' : '')"
                    t-att-disabled="!day.inMonth" t-on-click="() => day.row &amp;&amp; this.openLogs(day.row)">
              <span class="o_bea_day_number" t-esc="day.number"/>
              <span t-if="day.inMonth" t-att-class="'o_bea_calendar_status ' + day.status">
                <b t-if="day.status !== 'not_marked'" t-esc="day.status === 'present' ? 'P' : day.status === 'absent' ? 'A' : day.status === 'halfday' ? 'HD' : 'L'"/>
                <t t-esc="day.statusLabel"/>
              </span>
              <span class="o_bea_calendar_fine" t-if="day.row &amp;&amp; day.row.fine_hours"><b>F</b> Fine <t t-esc="formatHours(day.row.fine_hours)"/></span>
            </button>
          </div>
        </section>
        <div class="o_bea_modal_backdrop" t-if="state.selectedDay" t-on-click.self="closeLogs">
          <section class="o_bea_log_modal" role="dialog" aria-modal="true" aria-labelledby="o_bea_log_title">
            <button type="button" class="o_bea_modal_close" t-on-click="closeLogs" aria-label="Close"><i class="fa fa-times"/></button>
            <h3 id="o_bea_log_title" t-esc="state.data.employee.name"/>
            <p t-esc="formatDate(state.selectedDay.date)"/>
            <div class="o_bea_log_scroll">
              <article class="o_bea_log" t-foreach="state.selectedDay.logs" t-as="log" t-key="log.id">
                <img t-if="log.image_url" t-att-src="log.image_url" t-att-alt="log.label"/>
                <div t-else="" class="o_bea_log_placeholder"><i class="fa fa-user"/></div>
                <div class="o_bea_log_copy">
                  <strong><i t-att-class="'fa ' + (log.type === 'check_in' ? 'fa-sign-in' : 'fa-sign-out')"/> <t t-esc="log.label"/> via <t t-esc="log.mode"/></strong>
                  <span t-if="log.address" t-esc="log.address"/>
                  <small>By <t t-esc="state.data.employee.name"/> at <t t-esc="log.time"/></small>
                </div>
              </article>
              <div class="o_bea_no_logs" t-if="!state.selectedDay.logs.length"><i class="fa fa-camera"/><span>No punch logs were captured for this day.</span></div>
            </div>
            <button type="button" class="btn btn-outline-primary o_bea_done" t-on-click="closeLogs">Done</button>
          </section>
        </div>
      </t>
    </main>
  </t>
</templates>
