<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="bambus_hr_daily_ops.AttendanceDashboard">
    <div class="o_bambus_attendance_dashboard">
      <div class="o_bad_toolbar">
        <div><h2>Attendance Dashboard</h2><span t-if="state.data" t-esc="state.data.company"/></div>
        <div class="o_bad_actions" t-if="state.data">
          <button class="btn btn-light" t-on-click="() => this.moveDate(-1)" title="Previous day"><i class="fa fa-chevron-left"/></button>
          <input class="form-control" type="date" t-att-value="state.data.date" t-on-change="changeDate"/>
          <button class="btn btn-light" t-on-click="() => this.moveDate(1)" title="Next day"><i class="fa fa-chevron-right"/></button>
          <button class="btn btn-outline-secondary" t-on-click="openHistory">History</button>
          <button t-if="state.data.sheet_id" class="btn btn-primary" t-on-click="openSheet">Manage Attendance</button>
        </div>
      </div>
      <div t-if="state.loading" class="o_bad_loading"><i class="fa fa-spinner fa-spin"/> Loading attendance…</div>
      <t t-elif="state.data">
        <div t-if="!state.data.sheet_id" class="o_bad_empty">
          <i class="fa fa-calendar-o"/><h3>No attendance sheet for this date</h3>
          <p>Browsing does not create records automatically.</p>
          <button class="btn btn-primary" t-on-click="createSheet">Create Attendance Sheet</button>
        </div>
        <t t-else="">
          <div class="o_bad_context"><span class="badge text-bg-info" t-esc="state.data.state_label"/><span>Showing one daily sheet for the selected company</span></div>
          <div class="o_bad_metrics">
            <t t-foreach="[['total','All Staff','fa-users'],['present','Present','fa-check-circle'],['absent','Absent','fa-times-circle'],['halfday','Half Day','fa-adjust'],['leave','Leave','fa-plane'],['punched_in','Punched In','fa-sign-in'],['punched_out','Punched Out','fa-sign-out'],['not_marked','Not Marked','fa-question-circle'],['overtime','OT Hours','fa-clock-o'],['fine','Fine Hours','fa-money']]" t-as="metric" t-key="metric[0]">
              <div class="o_bad_metric"><i t-att-class="'fa ' + metric[2]"/><div><span t-esc="metric[1]"/><strong t-esc="state.data.metrics[metric[0]]"/></div></div>
            </t>
          </div>
          <div class="o_bad_summaries">
            <t t-foreach="[['Department Attendance',state.data.departments],['Shift Attendance',state.data.shifts]]" t-as="summary" t-key="summary[0]">
              <section class="o_bad_card"><h3 t-esc="summary[0]"/><table class="table table-sm"><thead><tr><th>Name</th><th>Total</th><th>P</th><th>A</th><th>HD</th><th>L</th><th>NM</th></tr></thead><tbody><tr t-foreach="summary[1]" t-as="row" t-key="row.name"><td t-esc="row.name"/><td t-esc="row.total"/><td t-esc="row.present"/><td t-esc="row.absent"/><td t-esc="row.halfday"/><td t-esc="row.leave"/><td t-esc="row.not_marked"/></tr></tbody></table></section>
            </t>
          </div>
          <section class="o_bad_card o_bad_daily">
            <div class="o_bad_section_title"><div><h3>Daily Attendance</h3><span t-esc="employees.length + ' employees'"/></div><input class="form-control" placeholder="Search employee, department, shift or status" t-model="state.query"/></div>
            <div class="table-responsive"><table class="table table-hover"><thead><tr><th>Employee</th><th>Department</th><th>Shift</th><th>Status</th><th>In</th><th>Out</th><th>Worked</th><th>OT</th><th>Fine</th><th>Fine Amount</th></tr></thead><tbody><tr t-foreach="employees" t-as="employee" t-key="employee.id"><td class="fw-semibold" t-esc="employee.name"/><td t-esc="employee.department"/><td t-esc="employee.shift"/><td><span t-att-class="'o_bad_status ' + employee.status" t-esc="employee.status_label"/></td><td t-esc="employee.check_in"/><td t-esc="employee.check_out"/><td t-esc="employee.worked_hours"/><td t-esc="employee.overtime"/><td t-esc="employee.fine"/><td t-esc="employee.fine_amount"/></tr></tbody></table></div>
          </section>
        </t>
      </t>
    </div>
  </t>
</templates>
