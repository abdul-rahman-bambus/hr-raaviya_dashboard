<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="bambus_hr_daily_ops.AttendanceDashboard">
    <div class="o_bambus_attendance_dashboard">
      <div class="o_bad_toolbar">
        <div><h2>Attendance Dashboard</h2><span t-if="state.data" t-esc="state.data.company"/></div>
        <button class="btn btn-outline-secondary" t-if="state.data" t-on-click="openHistory">History</button>
      </div>
      <div t-if="state.loading" class="o_bad_loading"><i class="fa fa-spinner fa-spin"/> Loading attendance…</div>
      <div t-elif="state.error" class="alert alert-danger o_bad_error" role="alert">
        <strong>Attendance dashboard could not be loaded.</strong>
        <div t-esc="state.error"/>
        <button class="btn btn-outline-danger btn-sm mt-2" t-on-click="() => this.load()">Try Again</button>
      </div>
      <t t-elif="state.data">
          <div class="o_bad_context"><i class="fa fa-users"/><strong>Attendance Metrics</strong><span>Loaded from employees, attendance punches and approved time off</span></div>
          <div class="o_bad_metrics">
            <t t-foreach="[['total','All Staff','fa-users'],['present','Present','fa-check-circle'],['absent','Absent','fa-times-circle'],['halfday','Half Day','fa-adjust'],['punched_in','Punched In','fa-sign-in'],['punched_out','Punched Out','fa-sign-out'],['not_marked','Not Marked','fa-question-circle'],['leave','On Leave','fa-plane'],['upcoming_leaves','Upcoming Leaves','fa-calendar'],['overtime','Overtime Hours','fa-clock-o','hours'],['fine','Fine Hours','fa-money','hours'],['on_duty','On Duty','fa-briefcase'],['upcoming_on_duty','Upcoming On Duty','fa-calendar-plus-o'],['deactivated','Deactivated','fa-user-times'],['daily_work_entries','Daily Work Entries','fa-list-alt']]" t-as="metric" t-key="metric[0]">
              <div class="o_bad_metric"><i t-att-class="'fa ' + metric[2]"/><div><span t-esc="metric[1]"/><strong t-esc="metricValue(metric)"/></div></div>
            </t>
          </div>
          <h3 class="o_bad_charts_title">Attendance Charts</h3>
          <div class="o_bad_charts_grid">
          <section class="o_bad_department_card">
            <div class="o_bad_department_header">
              <div><i class="fa fa-building-o"/><strong>Department Attendance</strong></div>
              <span><i class="fa fa-calendar"/><t t-esc="state.data.date"/></span>
            </div>
            <div class="table-responsive">
              <table class="table o_bad_department_table">
                <thead><tr><th>Department</th><th title="Present">P</th><th title="Absent">A</th><th title="Not Marked">NM</th><th title="Half Day">HD</th><th title="Overtime">OT</th><th title="Fine">F</th><th title="Leave">L</th></tr></thead>
                <tbody>
                  <tr t-foreach="state.data.departments" t-as="department" t-key="department.id">
                    <td t-esc="department.name"/><td t-esc="department.present"/><td t-esc="department.absent"/><td t-esc="department.not_marked"/><td t-esc="department.halfday"/><td t-esc="department.overtime"/><td t-esc="department.fine"/><td t-esc="department.leave"/>
                  </tr>
                  <tr t-if="!state.data.departments.length"><td colspan="8" class="text-muted text-center">No employees found for this company</td></tr>
                </tbody>
              </table>
            </div>
          </section>
          <section class="o_bad_department_card">
            <div class="o_bad_department_header">
              <div><i class="fa fa-clock-o"/><strong>Shift Attendance</strong></div>
              <span><i class="fa fa-calendar"/><t t-esc="state.data.date"/></span>
            </div>
            <div class="table-responsive">
              <table class="table o_bad_department_table">
                <thead><tr><th>Work Schedule</th><th title="Present">P</th><th title="Absent">A</th><th title="Not Marked">NM</th><th title="Half Day">HD</th><th title="Overtime">OT</th><th title="Fine">F</th><th title="Leave">L</th></tr></thead>
                <tbody>
                  <tr t-foreach="state.data.shifts" t-as="shift" t-key="shift.id">
                    <td t-esc="shift.name"/><td t-esc="shift.present"/><td t-esc="shift.absent"/><td t-esc="shift.not_marked"/><td t-esc="shift.halfday"/><td t-esc="shift.overtime"/><td t-esc="shift.fine"/><td t-esc="shift.leave"/>
                  </tr>
                  <tr t-if="!state.data.shifts.length"><td colspan="8" class="text-muted text-center">No work schedules found for this company</td></tr>
                </tbody>
              </table>
            </div>
          </section>
          </div>
          <section class="o_bad_daily_card">
            <div class="o_bad_daily_header">
              <div><i class="fa fa-id-card-o"/><strong>Daily Attendance View</strong></div>
              <div class="o_bad_daily_tools o_bad_dashboard_tools">
                <div class="o_bad_dashboard_search"><i class="fa fa-search"/><input type="search" placeholder="Search by Name" t-att-value="state.query" t-on-input="updateQuery"/></div>
                <label class="o_bad_filter_control"><i class="fa fa-filter"/><select t-att-value="state.statusFilter" t-on-change="updateStatusFilter"><option value="all">Filter</option><option value="present">Present</option><option value="absent">Absent</option><option value="not_marked">Not Marked</option><option value="halfday">Half Day</option><option value="leave">Leave</option></select></label>
                <div class="o_bad_inline_date"><button type="button" t-on-click="() => this.moveDate(-1)" title="Previous day"><i class="fa fa-chevron-left"/></button><input type="date" t-att-value="state.data.date" t-on-change="(ev) => this.changeDate(ev)"/><button type="button" t-on-click="() => this.moveDate(1)" title="Next day"><i class="fa fa-chevron-right"/></button></div>
                <button class="btn btn-outline-primary" t-on-click="downloadDailyAttendance"><i class="fa fa-download"/> Download</button>
              </div>
            </div>
            <div class="table-responsive">
              <table class="table table-hover o_bad_daily_table">
                <thead><tr><th>Employee</th><th>Department</th><th>Work Schedule</th><th>Attendance</th><th>Punch In</th><th>Punch Out</th><th>Fine</th></tr></thead>
                <tbody>
                  <tr t-foreach="dashboardEmployees" t-as="employee" t-key="employee.id"><td class="fw-semibold" t-esc="employee.name"/><td t-esc="employee.department"/><td t-esc="employee.shift"/><td><span t-att-class="'o_bad_daily_status ' + employee.status" t-esc="employee.status_label"/></td><td t-esc="employee.check_in || '—'"/><td t-esc="employee.check_out || '—'"/><td t-esc="fineDisplay(employee.fine_hours)"/></tr>
                  <tr t-if="!dashboardEmployees.length"><td colspan="7" class="text-muted text-center">No employees match the selected filters</td></tr>
                </tbody>
              </table>
            </div>
            <div class="o_bad_pagination">
              <div class="o_bad_page_summary">
                Showing <strong t-esc="dashboardFirstVisibleEmployee"/>–<strong t-esc="dashboardLastVisibleEmployee"/> of <strong t-esc="filteredDailyEmployees.length"/> employees
              </div>
              <div class="o_bad_page_size">
                <label for="o_bad_page_size">Rows per page</label>
                <select id="o_bad_page_size" class="form-select form-select-sm" t-att-value="state.pageSize" t-on-change="updatePageSize">
                  <option value="10">10</option><option value="25">25</option><option value="50">50</option>
                </select>
              </div>
              <div class="btn-group o_bad_page_controls" role="group" aria-label="Daily attendance pagination">
                <button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.currentPage === 1" t-on-click="() => this.goToDashboardPage(state.currentPage - 1)" aria-label="Previous page"><i class="fa fa-chevron-left"/></button>
                <span class="btn btn-light btn-sm disabled">Page <t t-esc="state.currentPage"/> of <t t-esc="dashboardPageCount"/></span>
                <button class="btn btn-outline-secondary btn-sm" t-att-disabled="state.currentPage === dashboardPageCount" t-on-click="() => this.goToDashboardPage(state.currentPage + 1)" aria-label="Next page"><i class="fa fa-chevron-right"/></button>
              </div>
            </div>
          </section>
      </t>
    </div>
  </t>
</templates>
