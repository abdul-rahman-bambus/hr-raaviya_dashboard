<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_inherit_face_attendance" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.face.attendance</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_attendance.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='hr_attendance']" position="inside">
                <block title="Employee Tracking" name="employee_tracking_setting_container">
                    <setting string="Employee Tracking" company_dependent="1" help="Enable real-time location tracking for employees during attendance.">
                        <field name="employee_tracking"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
