<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_employee_view_form_custom_inherit" model="ir.ui.view">
        <field name="name">hr_employee_view_form_custom_inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_attendance.view_employee_form_inherit_hr_attendance" />
        <field name="arch" type="xml">
            <xpath expr='//field[@name="attendance_manager_id"]' position='after'>
                <field name="is_enrolled" string="Is Enrolled" />
                <field name="last_photo_update_time" string="Last photo update time"/>
            </xpath>
            <xpath expr="//field[@name='category_ids']" position="after">
                <separator string="Tracking" invisible="not has_employee_tracking"/>
                <field name="has_employee_tracking" invisible="1"/>
                <field name="track_employee" string="Track Employee" invisible="not has_employee_tracking"/>
                <field name="track_map_url" string="Open in Google Maps" widget="url" text="Open in Google Maps" invisible="not has_employee_tracking or not track_employee or not track_map_url" readonly="1"/>
                <field name="track_latitude" invisible="1"/>
                <field name="track_longitude" invisible="1"/>
                <field name="track_last_updated_at" invisible="1"/>
                <field name="tracking_route_url" invisible="1"/>
                <div invisible="not has_employee_tracking or not track_employee" colspan="2" class="o_employee_live_map_wrapper">
                    <widget name="employee_live_tracking_map"/>
                </div>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page string="Live Tracking Logs" invisible="1">
                    <field name="location_log_ids" readonly="1">
                        <list default_order="timestamp desc">
                            <field name="timestamp" string="Timestamp" />
                            <field name="latitude" string="Latitude" />
                            <field name="longitude" string="Longitude" />
                            <field name="map_url" widget="url" text="Open in Google Maps" string="Maps Link" />
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="hr_employee_public_view_form_custom_inherit" model="ir.ui.view">
        <field name="name">hr_employee_public_view_form_custom_inherit</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form" />
        <field name="arch" type="xml">
            <xpath expr='//field[@name="work_email"]' position='after'>
                <field name="track_employee" invisible="1" />
                <field name="track_latitude" string="Latitude" invisible="not track_employee" readonly="1" />
                <field name="track_longitude" string="Longitude" invisible="not track_employee" readonly="1" />
                <field name="track_last_updated_at" string="Last Location Update" invisible="not track_employee" readonly="1" />
                <field name="track_map_url" string="Open in Maps" widget="url" text="Open in Google Maps" invisible="not track_employee or not track_latitude or not track_longitude" readonly="1" />
                <field name="tracking_route_url" string="Open tracking route" widget="url" text="Open tracking route" invisible="not track_employee or not tracking_route_url" readonly="1" />
            </xpath>
        </field>
    </record>

    <record id="hr_employee_view_form_portal_user_inherit" model="ir.ui.view">
        <field name="name">hr_employee_view_form_portal_user_inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form" />
        <field name="arch" type="xml">
            <xpath expr='//page[@name="hr_settings"]//field[@name="user_id"]' position="attributes">
                <attribute name="domain">['|', ('company_ids', '=', False), ('company_ids', 'in', company_id)]</attribute>
            </xpath>
        </field>
    </record>

    <record id="res_users_view_form_portal_employee_inherit" model="ir.ui.view">
        <field name="name">res_users_view_form_portal_employee_inherit</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form" />
        <field name="arch" type="xml">
            <xpath expr='//button[@name="action_create_employee"]' position="attributes">
                <attribute name="invisible">not id or share or employee_id</attribute>
            </xpath>
        </field>
    </record>
</odoo>
