<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_view_form_custom_inherit" model="ir.ui.view">
        <field name="name">hr_attendance_view_form_custom_inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
        <field name="arch" type="xml">
            <xpath expr='//field[@name="check_out"]' position='after'>
                <field name="recognized_face_checkin" widget="image" readonly="1" />
                <field name="recognized_face_checkout" widget="image" readonly="1" />
                <field name='attendance_client_id' readonly="1" />
                <field name="checkin_address" readonly="1" />
                <field name="checkout_address" readonly="1" />
                <field name="track_employee" invisible="1" />
                <field name="location_track_logs" invisible="1" readonly="1" />
                <field name="tracking_route_url" widget="url" text="Open tracking route" string="Open tracking route" invisible="not track_employee or not tracking_route_url" readonly="1" />
                <div invisible="not track_employee or not location_track_logs" colspan="2" class="o_attendance_route_map_wrapper">
                    <widget name="attendance_route_map"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
