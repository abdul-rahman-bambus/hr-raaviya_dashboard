<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="hr_attendance_view_form_custom_inherit" model="ir.ui.view">
        <field name="name">hr_attendance_view_form_custom_inherit</field>
        <field name="model">hr.attendance</field>
        <field name="inherit_id" ref="hr_attendance.hr_attendance_view_form" />
        <field name="arch" type="xml">
            <xpath expr='//field[@name="check_out"]' position='after'>
                <field name="recognized_face_checkin" widget="image"  readonly="1" />
                <field name="recognized_face_checkout" widget="image"  readonly="1" />
                <field name='attendance_client_id' readonly="1"/> 
            </xpath>
            <xpath expr="//group[@name='check_in_group']/group[2]/div[@name='in_location_info']" position="after">
                <label for="checkin_reverse_address" string="Checkin address"/>
                <div>
                    <field name="checkin_reverse_address" readonly="1" nolabel="1"/>
                </div>
            </xpath>
            <xpath expr="//group[@name='check_out_group']/group[2]/div[@name='out_location_info']" position="after">
                <label for="checkout_reverse_address" string="Checkout address"/>
                <div>
                    <field name="checkout_reverse_address" readonly="1" nolabel="1"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
